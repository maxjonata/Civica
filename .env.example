# Local Node development. Copy to .env and fill in the values you need.
NODE_ENV=development
PORT=3000

# Postgres connection string for local Node development.
# Keep the real value in .env and in your password manager, never in Git.
DATABASE_URL=

# Optional external map/source integration; leave blank when unused.
MANUS_API_URL=
MANUS_API_BROWSER_KEY=
