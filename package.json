{
  "name": "civica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": ">=7.29.6",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": ">=2.11.0",
      "browserslist@<=4.28.6": ">=4.28.7",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "minimatch": "11.0.1",
      "nanoid@<3.3.12": ">=3.3.12",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.18": ">=3.3.18",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "postcss@<8.5.10": ">=8.5.10",
      "postcss@<=8.5.11": ">=8.5.12",
      "postcss@<=8.5.17": ">=8.5.18",
      "postcss@<=8.5.22": ">=8.5.23",
      "proxy-addr@>=1.1.0 <2.0.8": ">=2.0.8",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "tailwindcss>nanoid": "3.3.7"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts server/_core/vite.ts --platform=node --packages=external --external:./vite.js --bundle --format=esm --outdir=dist && esbuild scripts/pilot.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/pilot.js",
    "cf:assets": "vite build",
    "cf:dev": "pnpm cf:assets && wrangler dev",
    "cf:dry-run": "pnpm cf:assets && wrangler deploy --dry-run",
    "cf:deploy": "pnpm cf:assets && wrangler deploy",
    "cf:typegen": "wrangler types",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "eslint server client/src shared tests scripts --no-warn-ignored",
    "format": "prettier --write server client/src shared tests scripts",
    "test": "node scripts/test-isolated.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:civic-browser": "node scripts/test-civic-browser.mjs",
    "migrate:civic:mysql-test": "node scripts/migrate-civic.mjs",
    "quality": "node scripts/quality.mjs",
    "pilot": "tsx scripts/pilot.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "cookie": "1.0.2",
    "dotenv": "17.2.3",
    "express": "4.22.3",
    "mysql2": "3.24.6",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "0.35.5",
    "wouter": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/express": "4.17.21",
    "@types/node": "24.7.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.6.2",
    "supertest": "7.3.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
